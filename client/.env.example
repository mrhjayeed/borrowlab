# ==============================================================================
# BorrowLab Frontend Client — Environment Configuration Template
# Copy this file to .env.local if you need to override frontend defaults.
# ==============================================================================

# Backend API Base URL
# In local development, leave unset to use Vite's proxy (/api -> http://localhost:5000)
# In production, set to your deployed backend API endpoint:
# VITE_API_BASE=https://api.borrowlab.yourdomain.com/api
VITE_API_BASE=/api
