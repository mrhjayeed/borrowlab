# ==============================================================================
# BorrowLab API Server — Environment Configuration Template
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Option 1: Individual Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGDATABASE=borrowlab

# Option 2: Full Database Connection URL (Recommended for cloud deployments like Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/borrowlab

# SSL connection for cloud-hosted databases (set to true for managed PostgreSQL providers)
PGSSL=false

# JWT Secret Key
# WARNING: Must be changed to a secure, random string (minimum 32 characters) for production!
# e.g., run in terminal: openssl rand -base64 32
JWT_SECRET=borrowlab_dev_jwt_secret_change_in_production_2026

# Allowed Frontend Origins (CORS)
# Comma-separated list of allowed frontend domains or single URL
# e.g., https://borrowlab.app,https://borrowlab.vercel.app
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
